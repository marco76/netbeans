<#assign baseName = name?replace("[.]pipe$", "", "r")>
<#assign className = "">
<#list baseName?split("[-_. ]", "r") as part>
    <#assign className = className + part?cap_first>
</#list>
import { Pipe, PipeTransform } from '@angular/core';

@Pipe({
  name: '${className?uncap_first}',
  standalone: true
})
export class ${className}Pipe implements PipeTransform {
  transform(value: unknown): unknown {
    return value;
  }
}
