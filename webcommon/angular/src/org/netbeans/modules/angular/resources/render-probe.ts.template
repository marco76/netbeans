import { isDevMode, NgZone, SimpleChanges } from '@angular/core';

// Optional development instrumentation. Invoke from your existing lifecycle hooks.
// This records checks, not DOM renders or proven signal causality.
type TraceEvent = { time: number; instance: string; component: string; source: string;
  kind: 'inputs' | 'check' | 'mark'; detail: string; changes?: Record<string, unknown> };
const events: TraceEvent[] = [];
const pending: TraceEvent[] = [];
const references = new WeakMap<object, number>();
let referenceId = 0;
let instanceId = 0;
let endpoint = '';
let timer: ReturnType<typeof setInterval> | undefined;
let sending = false;

function snapshot(value: unknown): unknown {
  if (value === null) return null;
  if (typeof value === 'string') return value.slice(0, 512);
  if (typeof value === 'number' || typeof value === 'boolean') return value;
  if (typeof value === 'undefined') return '[undefined]';
  if (typeof value === 'object' || typeof value === 'function') {
    const object = value as object;
    if (!references.has(object)) references.set(object, ++referenceId);
    return { reference: references.get(object), kind: Array.isArray(value) ? 'array' : typeof value };
  }
  return String(value).slice(0, 512);
}
function record(event: TraceEvent): void {
  events.push(event); pending.push(event);
  if (events.length > 2000) events.shift();
  if (pending.length > 500) pending.shift();
}
async function flush(): Promise<void> {
  if (!endpoint || sending || !pending.length) return;
  sending = true;
  const batch = pending.splice(0, 100);
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 3000);
  try {
    const response = await fetch(endpoint, { method: 'POST', mode: 'cors',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ version: 1, events: batch }), signal: controller.signal });
    if (!response.ok) throw new Error('Trace receiver rejected the batch');
  } catch {
    pending.unshift(...batch);
    if (pending.length > 500) pending.splice(0, pending.length - 500);
  } finally { clearTimeout(timeout); sending = false; }
}
export function connectRenderProbe(url: string): void {
  if (!isDevMode()) return;
  const target = new URL(url);
  if (!['http:', 'https:'].includes(target.protocol) || !['localhost', '127.0.0.1', '[::1]'].includes(target.hostname)) {
    throw new Error('The render probe only connects to a local IDE receiver');
  }
  if (NgZone.isInAngularZone()) throw new Error('Connect from the browser console or NgZone.runOutsideAngular to avoid recording timer-induced checks');
  endpoint = target.toString();
  if (timer !== undefined) clearInterval(timer);
  timer = setInterval(() => { void flush(); }, 500);
}
export function disconnectRenderProbe(): void {
  endpoint = '';
  if (timer !== undefined) clearInterval(timer);
  timer = undefined;
}
export function downloadRenderTrace(): void {
  if (!isDevMode() || typeof document === 'undefined') return;
  const url = URL.createObjectURL(new Blob([JSON.stringify({ version: 1, events }, null, 2)], { type: 'application/json' }));
  const link = document.createElement('a'); link.href = url; link.download = 'angular-render-trace.json';
  link.click(); setTimeout(() => URL.revokeObjectURL(url), 1000);
}
export class AlpRenderProbe {
  private readonly enabled = isDevMode() && typeof window !== 'undefined';
  private readonly instance = String(++instanceId);
  private changed: string[] = [];
  constructor(private readonly component: string, private readonly source: string) {}
  changes(changes: SimpleChanges): void {
    if (!this.enabled) return;
    const values: Record<string, unknown> = Object.create(null) as Record<string, unknown>;
    this.changed = Object.keys(changes);
    for (const name of this.changed) {
      const change = changes[name];
      values[name] = { previous: snapshot(change.previousValue), current: snapshot(change.currentValue), firstChange: change.firstChange };
    }
    this.emit('inputs', 'Inputs changed: ' + this.changed.join(', '), values);
  }
  check(): void {
    if (!this.enabled) return;
    this.emit('check', this.changed.length ? 'Check following input changes: ' + this.changed.join(', ')
      : 'Check observed; no input change recorded. Trigger unknown.');
    this.changed = [];
  }
  mark(description: string): void { if (this.enabled) this.emit('mark', description.slice(0, 512)); }
  private emit(kind: TraceEvent['kind'], detail: string, changes?: Record<string, unknown>): void {
    record({ time: Date.now(), instance: this.instance, component: this.component, source: this.source, kind, detail, changes });
  }
}
if (isDevMode() && typeof window !== 'undefined') {
  (window as unknown as { alpRenderProbe: unknown }).alpRenderProbe = {
    connect: connectRenderProbe, disconnect: disconnectRenderProbe, download: downloadRenderTrace,
    dump: () => ({ version: 1, events: [...events] })
  };
}
